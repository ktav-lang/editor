{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ktav",
  "scopeName": "source.ktav",
  "fileTypes": ["ktav"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#compound-object-open" },
    { "include": "#compound-array-open" },
    { "include": "#top-level-inline-object" },
    { "include": "#top-level-inline-array" },
    { "include": "#implicit-root-object" },
    { "include": "#implicit-root-array" }
  ],
  "repository": {

    "implicit-root-object": {
      "begin": "^(?=\\s*(?![\\s\\[{:])(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)\\s*|(?!(?:\\s*)[\"'`])(?:\\\\.|[^:.\\\\])*?)(?:\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)\\s*|(?!(?:\\s*)[\"'`])(?:\\\\.|[^:.\\\\])*?))*\\s*(?:::|:(?=\\s|$)))",
      "end": "(?!)",
      "patterns": [ { "include": "#comment" }, { "include": "#pair" } ]
    },

    "implicit-root-array": {
      "begin": "^(?=\\s*\\S)",
      "end": "(?!)",
      "patterns": [
        { "include": "#comment" },
        { "include": "#array-multiline-verbatim-open" },
        { "include": "#array-multiline-stripped-open" },
        { "include": "#array-compound-object-open" },
        { "include": "#array-compound-array-open" },
        { "include": "#array-item" }
      ]
    },

    "comment": {
      "match": "^\\s*##.*$",
      "name": "comment.line.number-sign.ktav"
    },

    "compound-object-open": {
      "begin": "^\\s*(\\{)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.braces.begin.ktav" }
      },
      "end": "^\\s*(\\})\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.braces.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#multiline-verbatim-open" },
        { "include": "#multiline-stripped-open" },
        { "include": "#compound-object-open" },
        { "include": "#compound-array-open" },
        { "include": "#pair" }
      ]
    },

    "compound-array-open": {
      "begin": "^\\s*(\\[)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.brackets.begin.ktav" }
      },
      "end": "^\\s*(\\])\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.brackets.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#array-multiline-verbatim-open" },
        { "include": "#array-multiline-stripped-open" },
        { "include": "#array-compound-object-open" },
        { "include": "#array-compound-array-open" },
        { "include": "#array-item" }
      ]
    },

    "array-compound-object-open": {
      "begin": "^\\s*(\\{)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.braces.begin.ktav" }
      },
      "end": "^\\s*(\\})\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.braces.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#multiline-verbatim-open" },
        { "include": "#multiline-stripped-open" },
        { "include": "#compound-object-open" },
        { "include": "#compound-array-open" },
        { "include": "#pair" }
      ]
    },

    "array-compound-array-open": {
      "begin": "^\\s*(\\[)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.brackets.begin.ktav" }
      },
      "end": "^\\s*(\\])\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.brackets.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#array-multiline-verbatim-open" },
        { "include": "#array-multiline-stripped-open" },
        { "include": "#array-compound-object-open" },
        { "include": "#array-compound-array-open" },
        { "include": "#array-item" }
      ]
    },

    "pair": {
      "patterns": [
        { "include": "#pair-raw" },
        { "include": "#pair-object-empty" },
        { "include": "#pair-array-empty" },
        { "include": "#pair-inline-object" },
        { "include": "#pair-inline-array" },
        { "include": "#pair-multiline-verbatim" },
        { "include": "#pair-multiline-stripped" },
        { "include": "#pair-object-open" },
        { "include": "#pair-array-open" },
        { "include": "#pair-string" }
      ]
    },

    "key-name": {
      "patterns": [
        { "match": "\"(?:\\\\.|[^\"\\\\])*\"", "name": "string.quoted.double.key.ktav" },
        { "match": "'(?:\\\\.|[^'\\\\])*'", "name": "string.quoted.single.key.ktav" },
        { "match": "`(?:\\\\.|[^`\\\\])*`", "name": "string.quoted.backtick.key.ktav" },
        { "match": "\\.", "name": "punctuation.accessor.dot.ktav" },
        {
          "match": "(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?(?=\\s*(?:\\.|$))",
          "name": "entity.name.tag.ktav",
          "captures": {
            "0": { "patterns": [ { "include": "#unicode-escape" }, { "match": "\\\\.", "name": "constant.character.escape.ktav" } ] }
          }
        }
      ]
    },

    "unicode-escape": {
      "patterns": [
        { "match": "\\\\u[dD][89abAB][0-9a-fA-F]{2}\\\\u[dD][c-fC-F][0-9a-fA-F]{2}", "name": "constant.character.escape.unicode.ktav" },
        { "match": "\\\\u[dD][89abAB][0-9a-fA-F]{2}(?!\\\\u[dD][c-fC-F][0-9a-fA-F]{2})", "name": "invalid.illegal.escape.unicode.ktav" },
        { "match": "(?<!\\\\u[dD][89abAB][0-9a-fA-F]{2})\\\\u[dD][c-fC-F][0-9a-fA-F]{2}", "name": "invalid.illegal.escape.unicode.ktav" },
        { "match": "\\\\u(?![dD][89a-fA-F])[0-9a-fA-F]{4}", "name": "constant.character.escape.unicode.ktav" },
        { "match": "\\\\u", "name": "invalid.illegal.escape.unicode.ktav" }
      ]
    },

    "pair-raw": {
      "match": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(::)(?:(\\s+)(.*?))?\\s*$",
      "captures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "keyword.operator.marker.raw.ktav" },
        "5": { "name": "string.unquoted.raw.ktav" }
      }
    },

    "pair-object-empty": {
      "match": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\{)\\s*(\\})\\s*$",
      "captures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.braces.begin.ktav" },
        "5": { "name": "punctuation.section.braces.end.ktav" }
      }
    },

    "pair-array-empty": {
      "match": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\[)\\s*(\\])\\s*$",
      "captures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.brackets.begin.ktav" },
        "5": { "name": "punctuation.section.brackets.end.ktav" }
      }
    },

    "pair-inline-object": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(?=\\{[^\\r\\n]*\\})",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" }
      },
      "end": "$",
      "patterns": [ { "include": "#inline-object" } ]
    },

    "pair-inline-array": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(?=\\[[^\\r\\n]*\\])",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" }
      },
      "end": "$",
      "patterns": [ { "include": "#inline-array" } ]
    },

    "inline-value": {
      "patterns": [
        { "include": "#inline-object" },
        { "include": "#inline-array" },
        { "include": "#inline-scalar" }
      ]
    },

    "inline-object": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.ktav" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.ktav" } },
      "patterns": [
        { "include": "#inline-pair-raw" },
        { "include": "#inline-pair" },
        { "include": "#inline-comma" }
      ]
    },

    "inline-array": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.ktav" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.brackets.end.ktav" } },
      "patterns": [
        { "include": "#inline-value" },
        { "include": "#inline-comma" }
      ]
    },

    "inline-pair": {
      "begin": "(?<=[{,])\\s*((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)(?!:)",
      "beginCaptures": {
        "1": { "patterns": [ { "include": "#key-name" } ] },
        "2": { "name": "punctuation.separator.key-value.ktav" }
      },
      "end": "(?=[,}\\]])",
      "patterns": [ { "include": "#inline-value" } ]
    },

    "inline-pair-raw": {
      "begin": "(?<=[{,])\\s*((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(::)",
      "beginCaptures": {
        "1": { "patterns": [ { "include": "#key-name" } ] },
        "2": { "name": "keyword.operator.marker.raw.ktav" }
      },
      "end": "(?=[,}\\]])",
      "patterns": [ { "include": "#inline-raw-scalar" } ]
    },

    "inline-scalar": {
      "match": "(true|false)(?=\\s*(?:[,}\\]]|$))|(null)(?=\\s*(?:[,}\\]]|$))|([+-]?(?:0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0o[0-7](?:_?[0-7])*|0b[01](?:_?[01])*|0|[1-9](?:_?[0-9])*))(?=\\s*(?:[,}\\]]|$))|([+-]?(?:0|[1-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*))(?=\\s*(?:[,}\\]]|$))|((?:[^\\s,}\\]{\\[\\\\]|\\\\.)(?:[^,}\\]\\\\]|\\\\.)*)",
      "captures": {
        "1": { "name": "constant.language.boolean.ktav" },
        "2": { "name": "constant.language.null.ktav" },
        "3": { "name": "constant.numeric.integer.ktav" },
        "4": { "name": "constant.numeric.float.ktav" },
        "5": {
          "name": "string.unquoted.ktav",
          "patterns": [
            { "include": "#unicode-escape" },
            { "match": "\\\\[\\\\,}\\]{\\[nr.:\"'`]", "name": "constant.character.escape.ktav" }
          ]
        }
      }
    },

    "inline-raw-scalar": {
      "match": "(?:[^\\s,}\\]\\\\]|\\\\.)(?:[^,}\\]\\\\]|\\\\.)*",
      "name": "string.unquoted.raw.ktav",
      "captures": {
        "0": { "patterns": [ { "include": "#inline-raw-scalar-body" } ] }
      }
    },

    "inline-raw-scalar-body": {
      "patterns": [
        { "include": "#unicode-escape" },
        { "match": "\\\\[\\\\,}\\]{\\[nr.:\"'`]", "name": "constant.character.escape.ktav" }
      ]
    },

    "inline-comma": {
      "match": ",",
      "name": "punctuation.separator.comma.ktav"
    },

    "pair-object-open": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\{)\\s*$",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.braces.begin.ktav" }
      },
      "end": "^\\s*(\\})\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.braces.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#multiline-verbatim-open" },
        { "include": "#multiline-stripped-open" },
        { "include": "#compound-object-open" },
        { "include": "#compound-array-open" },
        { "include": "#pair" }
      ]
    },

    "pair-array-open": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\[)\\s*$",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.brackets.begin.ktav" }
      },
      "end": "^\\s*(\\])\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.brackets.end.ktav" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#array-multiline-verbatim-open" },
        { "include": "#array-multiline-stripped-open" },
        { "include": "#array-compound-object-open" },
        { "include": "#array-compound-array-open" },
        { "include": "#array-item" }
      ]
    },

    "pair-multiline-verbatim": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\(\\()\\s*$",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\)\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.verbatim.ktav",
      "patterns": [
        { "include": "#multiline-verbatim-content" }
      ]
    },

    "pair-multiline-stripped": {
      "begin": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)\\s+(\\()\\s*$",
      "beginCaptures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "4": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.stripped.ktav",
      "patterns": [
        { "include": "#multiline-stripped-content" }
      ]
    },

    "pair-string": {
      "match": "^(\\s*)((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?)(?:\\s*\\.\\s*(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`)|(?:[^\\s\\[\\]{}():,.\\\\\"'`]|\\\\.)(?:[^\\r\\n\\[\\]{}():,.\\\\]|\\\\.)*?))*)\\s*(:)(?:(\\s+)(?:(true|false)|(null)|([+-]?(?:0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0o[0-7](?:_?[0-7])*|0b[01](?:_?[01])*|0|[1-9](?:_?[0-9])*))|([+-]?(?:0|[1-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*))|(.*?)))?\\s*$",
      "captures": {
        "2": { "patterns": [ { "include": "#key-name" } ] },
        "3": { "name": "punctuation.separator.key-value.ktav" },
        "5": { "name": "constant.language.boolean.ktav" },
        "6": { "name": "constant.language.null.ktav" },
        "7": { "name": "constant.numeric.integer.ktav" },
        "8": { "name": "constant.numeric.float.ktav" },
        "9": { "name": "string.unquoted.ktav" }
      }
    },

    "multiline-stripped-open": {
      "begin": "^\\s*(\\()\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.stripped.ktav",
      "patterns": [ { "include": "#multiline-stripped-content" } ]
    },

    "multiline-verbatim-open": {
      "begin": "^\\s*(\\(\\()\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\)\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.verbatim.ktav",
      "patterns": [ { "include": "#multiline-verbatim-content" } ]
    },

    "array-multiline-stripped-open": {
      "begin": "^\\s*(\\()\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.stripped.ktav",
      "patterns": [ { "include": "#multiline-stripped-content" } ]
    },

    "array-multiline-verbatim-open": {
      "begin": "^\\s*(\\(\\()\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.ktav" }
      },
      "end": "^\\s*(\\)\\))\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.ktav" }
      },
      "contentName": "string.quoted.multiline.verbatim.ktav",
      "patterns": [ { "include": "#multiline-verbatim-content" } ]
    },

    "multiline-stripped-content": {
      "match": "^.*$"
    },

    "multiline-verbatim-content": {
      "match": "^.*$"
    },

    "top-level-inline-object": {
      "begin": "^\\s*(?=\\{[^\\r\\n]*\\})",
      "end": "$",
      "patterns": [ { "include": "#inline-object" } ]
    },

    "top-level-inline-array": {
      "begin": "^\\s*(?=\\[[^\\r\\n]*\\])",
      "end": "$",
      "patterns": [ { "include": "#inline-array" } ]
    },

    "array-item": {
      "patterns": [
        { "include": "#array-item-raw" },
        { "include": "#array-item-inline-object" },
        { "include": "#array-item-inline-array" },
        { "include": "#array-item-keyword" },
        { "include": "#array-item-number" },
        { "include": "#array-item-string" }
      ]
    },

    "array-item-inline-object": {
      "begin": "^\\s*(?=\\{[^\\r\\n]*\\})",
      "end": "$",
      "patterns": [ { "include": "#inline-object" } ]
    },

    "array-item-inline-array": {
      "begin": "^\\s*(?=\\[[^\\r\\n]*\\])",
      "end": "$",
      "patterns": [ { "include": "#inline-array" } ]
    },

    "array-item-raw": {
      "match": "^(\\s*)(::)(?:(\\s+)(.*?))?\\s*$",
      "captures": {
        "2": { "name": "keyword.operator.marker.raw.ktav" },
        "4": { "name": "string.unquoted.raw.ktav" }
      }
    },

    "array-item-keyword": {
      "patterns": [
        {
          "match": "^\\s*(true|false)\\s*$",
          "captures": { "1": { "name": "constant.language.boolean.ktav" } }
        },
        {
          "match": "^\\s*(null)\\s*$",
          "captures": { "1": { "name": "constant.language.null.ktav" } }
        }
      ]
    },

    "array-item-number": {
      "match": "^\\s*([+-]?(?:0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0o[0-7](?:_?[0-7])*|0b[01](?:_?[01])*|(?:0|[1-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[eE][+-]?[0-9](?:_?[0-9])*)?))\\s*$",
      "captures": {
        "1": { "name": "constant.numeric.ktav" }
      }
    },

    "array-item-string": {
      "match": "^\\s*(.+?)\\s*$",
      "captures": {
        "1": { "name": "string.unquoted.ktav" }
      }
    }
  }
}
