{
  "name": "ktav",
  "displayName": "Ktav",
  "description": "Ktav configuration format — syntax highlighting and language support",
  "version": "0.8.0",
  "publisher": "ktav-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktav-lang/editor",
    "directory": "vscode"
  },
  "homepage": "https://github.com/ktav-lang/editor/tree/main/vscode",
  "bugs": {
    "url": "https://github.com/ktav-lang/editor/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Marat K <phpcraftdream@gmail.com>",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ktav",
    "config",
    "configuration"
  ],
  "icon": "./assets/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ktav"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting and the bundled ktav-lsp work in Restricted Mode; a server path from workspace settings is ignored until the workspace is trusted.",
      "restrictedConfigurations": ["ktav.server.path"]
    }
  },
  "contributes": {
    "colors": [
      {
        "id": "ktav.keyUnderline",
        "description": "Soft underline drawn under Ktav keys.",
        "defaults": {
          "light": "#15803D4D",
          "dark": "#6CC27F4D",
          "highContrast": "#15803D",
          "highContrastLight": "#15803D"
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "quoted",
        "description": "A key segment written in quoted form (§ 5.3.3)."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ktav",
        "scopes": {
          "property.quoted": ["string.quoted.double.key.ktav"]
        }
      }
    ],
    "languages": [
      {
        "id": "ktav",
        "aliases": [
          "Ktav",
          "ktav"
        ],
        "extensions": [
          ".ktav"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ktav",
        "scopeName": "source.ktav",
        "path": "./syntaxes/ktav.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ktav.restartServer",
        "title": "Ktav: Restart Language Server",
        "category": "Ktav"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Ktav",
      "properties": {
        "ktav.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the ktav-lsp binary. When empty, the extension first looks for a bundled binary under bin/<platform>-<arch>/, then falls back to `ktav-lsp` on PATH."
        },
        "ktav.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces communication between VS Code and the Ktav language server."
        }
      }
    },
    "configurationDefaults": {
      "[ktav]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "ktav-lang.ktav",
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.ambiguousCharacters": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "string.unquoted.ktav",
              "string.unquoted.raw.ktav",
              "string.quoted.multiline.stripped.ktav",
              "string.quoted.multiline.verbatim.ktav"
            ],
            "settings": { "foreground": "#1FB0FF" }
          },
          {
            "scope": [
              "constant.numeric.ktav",
              "constant.numeric.integer.ktav",
              "constant.numeric.float.ktav"
            ],
            "settings": { "foreground": "#2563EB" }
          },
          {
            "scope": ["constant.language.boolean.ktav"],
            "settings": { "foreground": "#C26A12" }
          },
          {
            "scope": ["constant.language.null.ktav"],
            "settings": { "foreground": "#B11A1A" }
          },
          {
            "scope": ["entity.name.tag.ktav"],
            "settings": { "foreground": "#15803D" }
          },
          {
            "scope": [
              "string.quoted.double.key.ktav",
              "string.quoted.single.key.ktav",
              "string.quoted.backtick.key.ktav"
            ],
            "settings": { "foreground": "#15803D", "fontStyle": "bold" }
          },
          {
            "scope": [
              "punctuation.definition.string.begin.ktav",
              "punctuation.definition.string.end.ktav"
            ],
            "settings": { "foreground": "#C026D3", "fontStyle": "bold" }
          },
          {
            "scope": ["comment.line.number-sign.ktav"],
            "settings": { "foreground": "#8A8A8A", "fontStyle": "italic" }
          }
        ]
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "string:ktav": "#1FB0FF",
          "number:ktav": "#2563EB",
          "keyword:ktav": "#C26A12",
          "null:ktav": "#B11A1A",
          "property:ktav": "#15803D",
          "property.quoted:ktav": { "foreground": "#15803D", "bold": true },
          "comment:ktav": { "foreground": "#8A8A8A", "italic": true }
        }
      }
    }
  },
  "scripts": {
    "sync-grammars": "node scripts/sync-grammars.js",
    "compile": "npm run sync-grammars && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run sync-grammars && npm run compile",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^10.4.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.3.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
