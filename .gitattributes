# Normalize text line endings to LF in the repository, regardless of
# contributor's platform or `core.autocrlf` setting. Working-tree files
# on all platforms check out with LF — no more CRLF/LF noise in
# `git status` from Windows clients.
* text=auto eol=lf

# Polydoc сохраняет пустую строку после абзаца source unit.
root-docs/**/body-*.md whitespace=-blank-at-eof
*/root-docs/**/body-*.md whitespace=-blank-at-eof

# Gradle wrapper script must stay LF for Linux/macOS builds; gradle.bat
# stays CRLF for Windows.
intellij/gradlew text eol=lf
intellij/gradlew.bat text eol=crlf
