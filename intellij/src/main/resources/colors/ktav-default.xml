<scheme name="Default" version="142" parent_scheme="Default">
  <!-- Ktav value-type palette (parity with the VS Code extension). Each data
       type gets a distinct colour. Users can override via Settings → Editor →
       Color Scheme → Ktav. Keys are green and underlined; the quotes of a quoted
       key are magenta. -->
  <attributes>
    <!-- strings — bright blue -->
    <option name="KTAV_STRING_VALUE">
      <value><option name="FOREGROUND" value="1fb0ff" /></value>
    </option>
    <!-- numbers — saturated blue -->
    <option name="KTAV_INT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <option name="KTAV_FLOAT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <!-- booleans — dark orange -->
    <option name="KTAV_BOOLEAN">
      <value><option name="FOREGROUND" value="c26a12" /></value>
    </option>
    <!-- null — dark red -->
    <option name="KTAV_NULL">
      <value><option name="FOREGROUND" value="b11a1a" /></value>
    </option>
    <!-- keys — green, with a soft underline so they never read as values -->
    <option name="KTAV_KEY">
      <value>
        <option name="FOREGROUND" value="15803d" />
        <option name="EFFECT_COLOR" value="a7d8b4" />
        <option name="EFFECT_TYPE" value="1" />
      </value>
    </option>
    <!-- quoted key content — same hue, bold -->
    <option name="KTAV_QUOTED_KEY">
      <value>
        <option name="FOREGROUND" value="15803d" />
        <option name="FONT_TYPE" value="1" />
        <option name="EFFECT_COLOR" value="a7d8b4" />
        <option name="EFFECT_TYPE" value="1" />
      </value>
    </option>
    <!-- paired quotes of a quoted key — magenta, bold -->
    <option name="KTAV_KEY_QUOTE">
      <value>
        <option name="FOREGROUND" value="c026d3" />
        <option name="FONT_TYPE" value="1" />
      </value>
    </option>
  </attributes>
</scheme>
