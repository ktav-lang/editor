<scheme name="Default" version="142" parent_scheme="Default">
  <!-- Ktav value-type palette (parity with the VS Code extension). Each data
       type gets a distinct colour. Users can override via Settings → Editor →
       Color Scheme → Ktav. Light-theme variant: keys are near-black. -->
  <attributes>
    <!-- strings — bright blue -->
    <option name="KTAV_STRING_VALUE">
      <value><option name="FOREGROUND" value="1fb0ff" /></value>
    </option>
    <!-- numbers — saturated blue -->
    <option name="KTAV_INT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <option name="KTAV_FLOAT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <!-- booleans — dark orange -->
    <option name="KTAV_BOOLEAN">
      <value><option name="FOREGROUND" value="c26a12" /></value>
    </option>
    <!-- null — dark red -->
    <option name="KTAV_NULL">
      <value><option name="FOREGROUND" value="b11a1a" /></value>
    </option>
    <!-- keys — dark gray (almost black) -->
    <option name="KTAV_KEY">
      <value><option name="FOREGROUND" value="333333" /></value>
    </option>
  </attributes>
</scheme>
