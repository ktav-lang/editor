<scheme name="Darcula" version="142" parent_scheme="Darcula">
  <!-- Ktav value-type palette (parity with the VS Code extension). Same hues
       as the light scheme, with lighter key and quote colours for a dark
       background. -->
  <attributes>
    <!-- strings — bright blue -->
    <option name="KTAV_STRING_VALUE">
      <value><option name="FOREGROUND" value="1fb0ff" /></value>
    </option>
    <!-- numbers — saturated blue -->
    <option name="KTAV_INT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <option name="KTAV_FLOAT_VALUE">
      <value><option name="FOREGROUND" value="2563eb" /></value>
    </option>
    <!-- booleans — dark orange -->
    <option name="KTAV_BOOLEAN">
      <value><option name="FOREGROUND" value="c26a12" /></value>
    </option>
    <!-- null — dark red -->
    <option name="KTAV_NULL">
      <value><option name="FOREGROUND" value="b11a1a" /></value>
    </option>
    <!-- keys — light green, with a soft underline so they never read as values -->
    <option name="KTAV_KEY">
      <value>
        <option name="FOREGROUND" value="6cc27f" />
        <option name="EFFECT_COLOR" value="3f6e4c" />
        <option name="EFFECT_TYPE" value="1" />
      </value>
    </option>
    <!-- quoted key content — same hue, bold -->
    <option name="KTAV_QUOTED_KEY">
      <value>
        <option name="FOREGROUND" value="6cc27f" />
        <option name="FONT_TYPE" value="1" />
        <option name="EFFECT_COLOR" value="3f6e4c" />
        <option name="EFFECT_TYPE" value="1" />
      </value>
    </option>
    <!-- paired quotes of a quoted key — magenta, bold -->
    <option name="KTAV_KEY_QUOTE">
      <value>
        <option name="FOREGROUND" value="e879f9" />
        <option name="FONT_TYPE" value="1" />
      </value>
    </option>
  </attributes>
</scheme>
